{
  "roles": {
    "onboarding_coordinator": {
      "example_user": "Ciaran Doyle",
      "summary": "HR record (DOB masked), vetting status and dates for the subject only (no reviewer comment), training, IT ticket, checklist, standards, offer and welcome emails, e-sign certificate. Clearance: status and date only - not the letter's reviewer notes or level."
    },
    "security_lead": {
      "example_user": "Aoife Brennan",
      "summary": "Everything about the subject, including full vetting history, and the clearance letter including page 2 reviewer notes."
    },
    "hiring_manager": {
      "example_user": "Michael Byrne",
      "summary": "Per-requirement met / not met status, offer email, welcome email, checklist, standards. No vetting register content, clearance letter, DOB or reviewer notes."
    },
    "it_service_desk": {
      "example_user": "Priya Nair",
      "summary": "IT ticket, IT FAQ, standards (access tier section). No vetting, clearance or HR personal data."
    }
  },
  "global_rules": [
    "For every role: rows about other joiners (including the similarly named Julia Sour, EMP-45812) are never shown in a case view for Julie Sour.",
    "A role with access 'status_only' may be told whether a requirement is met / not met, but never shown the document's content."
  ],
  "access_levels": {
    "full": "May see the subject's content in this document.",
    "masked": "May see the subject's content with the listed fields withheld.",
    "partial": "May see only the listed visible_fields / sections.",
    "status_only": "May be told met / not met per requirement derived from this document; no content.",
    "none": "No access."
  },
